;
; Minimal 8n1 UART receive program for DATA2/DATA3 PIO UARTs.
; IN pin 0 is mapped to the UART RX pin. Autopush after 8 bits; the received
; byte lands in the top byte of the RX FIFO word (shift-right), read via
; ((io_rw_8*)&pio->rxf[sm] + 3), matching the TX helper's conventions.

.program uart_rx

    wait 0 pin 0        ; Stall until start bit is asserted
    set x, 7    [10]    ; Preload bit counter, delay until eye of first data bit
bitloop:                ; This loop will run 8 times (8n1 UART)
    in pins, 1          ; Shift 1 bit from the RX pin into the ISR
    jmp x-- bitloop [6] ; Each loop iteration is 8 cycles

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

static inline void uart_rx_program_init(PIO pio, uint sm, uint offset, uint pin, uint baud) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    pio_gpio_init(pio, pin);
    gpio_pull_up(pin);

    pio_sm_config c = uart_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin); // for WAIT, IN
    sm_config_set_jmp_pin(&c, pin); // for JMP (not used by the minimal program)
    // Shift to the right, autopush enabled with a threshold of 8 bits
    sm_config_set_in_shift(&c, true, true, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    // SM receives 1 bit per 8 execution cycles (same timing as uart_tx)
    float div = (float)clock_get_hz(clk_sys) / (8 * baud);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline char uart_rx_program_getc(PIO pio, uint sm) {
    // The 8 data bits sit in the most-significant byte of the FIFO word.
    io_rw_8 *rxfifo_shift = (io_rw_8 *)&pio->rxf[sm] + 3;
    while (pio_sm_is_rx_fifo_empty(pio, sm)) {
        tight_loop_contents();
    }
    return (char)*rxfifo_shift;
}
%}
